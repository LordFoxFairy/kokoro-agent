# Template — copy to .env (gitignored) and fill in real values.

# Default chat model as "provider:model".
# 模型档位由 worker 的 provider 配置与请求中的可选 model label 共同决定；不在 Agent 声明中写凭据。

# Credentials for an OpenAI-compatible provider (leave blank if using Anthropic).
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Credentials for Anthropic (leave blank if using an OpenAI-compatible provider).
# ANTHROPIC_BASE_URL=
# ANTHROPIC_API_KEY=

# Set to 1 to disable streaming.
KOKORO_DISABLE_STREAMING=

# Transport = redis (only real backend). Storage (checkpoint / ledger / long-term memory) = postgres.
# KOKORO_REDIS_URL=redis://127.0.0.1:6379/0
# KOKORO_AGENT_DATABASE_URL=postgresql://localhost/postgres
# KOKORO_AGENT_DATABASE_SCHEMA=kokoro_agent

# Run-state lease (crash recovery): TTL and heartbeat interval in seconds.
# KOKORO_LEASE_TTL_S=90
# KOKORO_LEASE_HEARTBEAT_S=30

# openai 兼容端点（GLM/DeepSeek）带 reasoning_content 时置 1（thinking 通道需要）：
# ChatOpenAI 明文不解析该字段，此开关切 ChatDeepSeek 包装（须配 OPENAI_BASE_URL）。
# KOKORO_OPENAI_REASONING=1

# LiteLLM 是可选的外置 OpenAI-compatible gateway；kokoro-agent 不安装或启动 LiteLLM。
# 未启用时可直接使用 OPENAI_* 或 ANTHROPIC_* provider，Agent 默认不会尝试连接网关。
# KOKORO_LITELLM_ENABLED=0
# KOKORO_LITELLM_BASE_URL=http://127.0.0.1:4000/v1
# KOKORO_LITELLM_API_KEY=

# web 底层工具：fetch 恒挂载（SSRF 防御默认拒内网/非公网地址）。
# 本机跑 fake-IP 代理（Clash/Surge 等，域名解析进 198.18.0.0/15）时置 1 放行，生产勿开：
# KOKORO_WEB_FETCH_ALLOW_PRIVATE=1
# web_search 配置即挂载（无 provider 不挂空壳）。provider 可选 tavily / searxng / zhipu：
# KOKORO_WEB_SEARCH_PROVIDER=tavily
# KOKORO_WEB_SEARCH_API_KEY=
# searxng（自托管开放标准）用实例地址，无需 key。本地一键：
#   docker run -d --name kokoro-searxng --restart unless-stopped -p 8888:8080 \
#     -v <settings.yml 开启 formats:[html,json]>:/etc/searxng/settings.yml:ro searxng/searxng
# KOKORO_WEB_SEARCH_PROVIDER=searxng
# KOKORO_WEB_SEARCH_URL=http://127.0.0.1:8888

# Langfuse tracing（三者齐备才开；缺任一静默关闭）。本地自托管：官方 docker-compose
# + LANGFUSE_INIT_* headless 预置密钥（见 scripts/trace-verify.py 前置说明）：
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://127.0.0.1:3310

# 失控熔断：单 run 图步数上限（默认 100；命中即 run.failed(GraphRecursionError)）。
# KOKORO_RECURSION_LIMIT=100

# SIGTERM 优雅停机：限时等活跃 run 收尾（默认 60s；超时交 TTL 租约重拾）。
# KOKORO_DRAIN_TIMEOUT_S=60

# run 级 token 预算（0=关闭）：跨 HITL 段累计（store 背书），超限 run.failed(TokenBudgetExceeded)。
# KOKORO_RUN_TOKEN_BUDGET=0

# 内建子代理按名启用（默认全关）；工具不可用（如 search 未配 provider）时该子代理整个不挂。
# KOKORO_BUILTIN_SUBAGENTS=web-researcher

# ── Capability public contract 接线（MCP secret resolve）──
# agent 从 Capability public contract 读取 MCP 定义并解析 secret 句柄；缺省不接外部能力（本地纯 local 装配）。
# KOKORO_CAPABILITY_BASE_URL=http://kokoro-capability:8086
# 内部信任面凭据：agent→Capability 的服务调用带此凭据；生产按部署策略注入。
# KOKORO_INTERNAL_SECRET_AGENT=example-internal-secret-agent

# ── MCP（能力装配）──
# MCP server 部署注册表 yaml：wire 只传 names，定义在此解析；headers 值 ${ENV} 占位，凭据不进 yaml。
# KOKORO_MCP_CONFIG=/etc/kokoro/mcp.yaml
# MCP 连接期 egress 防线：strict（默认，拒私网/非白名单）| off（仅本地/test）。
# KOKORO_MCP_EGRESS_MODE=strict

# ── assets 域（skills / personas 从哪来）──
# 本地目录源；不配则走 assets_config/Capability。personas_dir 供目录化人格包（加文件零代码）。
# KOKORO_SKILLS_DIR=/etc/kokoro/skills
# KOKORO_PERSONAS_DIR=/etc/kokoro/personas

# 自定义子代理（SWARM）：JSON 串定义；未知名由 build_catalog fail-loud，不静默降级。
# KOKORO_CUSTOM_SUBAGENTS=

# ── 可靠性 / 可观测 ──
# R4 critical 帧 published 后回执不来的重发宽限期（毫秒，默认 30000）。
# KOKORO_OUTBOX_REPUBLISH_MS=30000
# OBS-1 metrics 端点端口（缺省关：worker 无常驻 HTTP 面，仅 e2e/部署显式开）。
# KOKORO_AGENT_METRICS_PORT=9090

# Agent 是可选部署 profile 的一部分，由 Root/BFF 编排层控制；默认不启动即可运行 Web+BFF。
# 启用完整执行 profile 时同时启动 kokoro-agent-http 与 kokoro-agent-worker。
# KOKORO_AGENT_ENABLED=0
