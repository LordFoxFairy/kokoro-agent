{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoro.dev/contracts/agent/execution-proof/v1/schema.json",
  "title": "Kokoro Agent Execution Proof Decoded Profile",
  "description": "The sole Agent-owned machine schema for the decoded protected header and claims of execution proof v1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protected_header",
    "claims"
  ],
  "properties": {
    "protected_header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typ",
        "alg",
        "kid"
      ],
      "properties": {
        "typ": {
          "const": "kokoro-agent-execution+jwt"
        },
        "alg": {
          "const": "EdDSA"
        },
        "kid": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "iss",
        "aud",
        "tenant_ref",
        "actor",
        "subject",
        "run_id",
        "execution_session_id",
        "lease_generation",
        "operation",
        "request_binding_sha256",
        "iat",
        "exp",
        "jti"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0.0"
        },
        "iss": {
          "type": "string",
          "minLength": 1
        },
        "aud": {
          "const": "https://kokoro.dev/resources/iam-execution-authorization"
        },
        "tenant_ref": {
          "type": "string",
          "minLength": 1
        },
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "opaque_ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user",
                "project",
                "service"
              ]
            },
            "opaque_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "opaque_ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "user",
                "project",
                "service"
              ]
            },
            "opaque_ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "execution_session_id": {
          "type": "string",
          "minLength": 1
        },
        "lease_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "x-kokoro-require-integer-token": true
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.]{0,127}$"
        },
        "request_binding_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "iat": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-kokoro-require-integer-token": true
        },
        "exp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "x-kokoro-require-integer-token": true
        },
        "jti": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{21}[AQgw]$",
          "x-kokoro-random-bits": 128,
          "x-kokoro-base64url-padding": "forbidden"
        }
      }
    }
  },
  "x-kokoro-contract-version": "1.0.0",
  "x-kokoro-wire-format": "compact-jws",
  "x-kokoro-canonicalization": "RFC 8785",
  "x-kokoro-string-normalization": "none",
  "x-kokoro-base64url-padding": "forbidden",
  "x-kokoro-compact-jws-max-bytes": 16384,
  "x-kokoro-claim-pair-rules": {
    "exp_must_be_greater_than_iat": true,
    "maximum_ttl_seconds": 60
  }
}
