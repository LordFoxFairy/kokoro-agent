{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kokoro.dev/contracts/platform-execution-operations/1.0.0/command-identities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactVersion",
    "commandDigestVersion",
    "packageName",
    "commands",
    "authorizeMcpToolIdempotency",
    "globalCommandIdentity"
  ],
  "properties": {
    "artifactVersion": {
      "const": "1.0.0"
    },
    "commandDigestVersion": {
      "const": "1.0.0"
    },
    "packageName": {
      "const": "kokoro.platform.v1"
    },
    "commands": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation",
          "fqMethod",
          "commandField",
          "rootMembers",
          "commandMembers",
          "excludedMembers"
        ],
        "properties": {
          "operation": {
            "type": "string"
          },
          "fqMethod": {
            "type": "string"
          },
          "commandField": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "tag", "type"],
            "properties": {
              "field": {
                "const": "command"
              },
              "tag": {
                "const": 2
              },
              "type": {
                "const": "kokoro.common.v1.CommandIdentity"
              }
            }
          },
          "rootMembers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commandMembers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "excludedMembers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "authorizeMcpToolIdempotency": {
      "const": "idempotency_key"
    },
    "globalCommandIdentity": {
      "const": "forbidden"
    }
  }
}
