  "semantics": {
    "requestId": "same logical retry keeps request_id; changing it changes binding",
    "proof": "fresh proof for every real send and excluded from request projection",
    "proto3Scalar": "decoded default is included",
    "presence": "optional and message fields use explicit {present,value}",
    "typedArgumentsSha256": "lowercase SHA-256 of raw typed_arguments_json Proto bytes without JSON parsing",
    "set": "reject blank and duplicate values, then sort by UTF-8 bytes",
    "array": "preserve wire order",
    "completedReceiptReplay": "fresh IAM decision is required before completed receipt replay",
    "currentState": "revalidate current resource and installation before replay or execution"
  },
  "projectionRegistry": {
    "OwnerScope": {
      "type": "object",
      "required": ["kind", "id"],
      "additionalProperties": false,
      "members": {
        "kind": "nonblank-string",
        "id": "nonblank-string"
      }
    },
    "Metadata": {
      "type": "object",
      "required": ["display_name", "summary", "tags", "metadata_json"],
      "additionalProperties": false,
      "members": {
        "display_name": "string",
        "summary": "string",
        "tags": "array<string>",
        "metadata_json": "base64url-no-pad"
      }
    },
    "Page": {
      "type": "object",
      "required": ["limit", "cursor"],
      "additionalProperties": false,
      "members": {
        "limit": "safe-integer",
        "cursor": "opt<string>"
      }
    },
    "CommandIdentity": {
      "type": "object",
      "required": ["command_id", "request_digest"],
      "additionalProperties": false,
      "members": {
        "command_id": "nonblank-string",
        "request_digest": "lowercase-64hex"
      }
    },
    "presence": {
      "type": "tagged-object",
      "discriminant": "present:boolean",
      "absentMembers": ["present"],
      "presentMembers": ["present", "value"],
      "additionalProperties": false
    },
    "idWrapper": {
      "type": "presence",
      "value": "exact named wrapper scalar domain"
    },
    "message": {
      "type": "presence",
      "value": "exact named object shape"
    },
    "optional": {
      "type": "presence",
      "value": "exact scalar shape"
    },
    "page": {
      "type": "presence",
      "value": "Page"
    },
    "command": {
      "type": "presence",
      "value": "CommandIdentity"
    },
    "executionProof": {
      "type": "object",
      "required": [
        "field",
        "tag",
        "wireType",
        "projection",
        "minBytes",
        "maxBytes",
        "encoding"
      ],
      "additionalProperties": false,
      "members": {
        "field": "execution_proof",
        "tag": 100,
        "wireType": "string",
        "projection": "excluded",
        "minBytes": 1,
        "maxBytes": 16384,
        "encoding": "ASCII compact JWS/JWT"
      }
    }
  },
