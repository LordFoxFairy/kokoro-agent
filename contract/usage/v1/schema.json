{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kokoro-agent:model-usage-evidence:v1",
  "title": "Agent model usage evidence",
  "x-artifact-version": "1.0.0",
  "x-max-json-bytes": 65536,
  "x-max-json-depth": 16,
  "$defs": {
    "Opaque": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "x-utf8-max-bytes": 512
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 19,
      "x-max-decimal": "9223372036854775807"
    },
    "Ordinal": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19,
      "x-max-decimal": "9223372036854775807"
    },
    "UtcInstant": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$",
      "x-calendar-valid": true
    },
    "IdentityRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "project",
            "service"
          ]
        },
        "opaque_ref": {
          "$ref": "#/$defs/Opaque"
        }
      },
      "required": [
        "kind",
        "opaque_ref"
      ]
    },
    "Lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "owner": {
          "$ref": "#/$defs/Opaque"
        },
        "generation": {
          "$ref": "#/$defs/Ordinal"
        }
      },
      "required": [
        "owner",
        "generation"
      ]
    },
    "EvidenceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "tenant_ref": {
          "$ref": "#/$defs/Opaque"
        },
        "actor": {
          "$ref": "#/$defs/IdentityRef"
        },
        "subject": {
          "$ref": "#/$defs/IdentityRef"
        },
        "identity_assertion_ref": {
          "$ref": "#/$defs/Opaque"
        },
        "run_id": {
          "$ref": "#/$defs/Opaque"
        },
        "session_id": {
          "$ref": "#/$defs/Opaque"
        },
        "call_id": {
          "$ref": "#/$defs/Uuid"
        },
        "attempt_id": {
          "$ref": "#/$defs/Uuid"
        },
        "attempt_ordinal": {
          "$ref": "#/$defs/Ordinal"
        },
        "lease": {
          "$ref": "#/$defs/Lease"
        },
        "input_digest": {
          "$ref": "#/$defs/Digest"
        },
        "peer_path": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "x-utf8-max-bytes": 128
          }
        }
      },
      "required": [
        "event_id",
        "tenant_ref",
        "actor",
        "subject",
        "identity_assertion_ref",
        "run_id",
        "session_id",
        "call_id",
        "attempt_id",
        "attempt_ordinal",
        "lease",
        "input_digest",
        "peer_path"
      ]
    },
    "PlannedBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "#/$defs/Opaque"
        },
        "provider": {
          "$ref": "#/$defs/Opaque"
        },
        "revision_id": {
          "$ref": "#/$defs/Opaque"
        },
        "provider_model_name": {
          "$ref": "#/$defs/Opaque"
        },
        "gateway_model_name": {
          "$ref": "#/$defs/Opaque"
        },
        "feature_key": {
          "$ref": "#/$defs/Opaque"
        },
        "revision": {
          "$ref": "#/$defs/Ordinal"
        },
        "generation": {
          "$ref": "#/$defs/Ordinal"
        },
        "tenant_generation": {
          "$ref": "#/$defs/Ordinal"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Opaque"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model",
        "provider",
        "revision_id",
        "provider_model_name",
        "gateway_model_name",
        "feature_key",
        "revision",
        "generation",
        "tenant_generation",
        "digest",
        "label"
      ]
    },
    "UnknownAttribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "enum": [
            "not_observed",
            "unverified_binding",
            "incomplete_attempt_coverage"
          ]
        }
      },
      "required": [
        "state",
        "reason"
      ]
    },
    "VerifiedAttribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "verified"
        },
        "provider_ref": {
          "$ref": "#/$defs/Opaque"
        },
        "model_ref": {
          "$ref": "#/$defs/Opaque"
        },
        "evidence_ref": {
          "$ref": "#/$defs/Opaque"
        },
        "evidence_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "state",
        "provider_ref",
        "model_ref",
        "evidence_ref",
        "evidence_digest"
      ]
    },
    "ActualAttribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnknownAttribution"
        },
        {
          "$ref": "#/$defs/VerifiedAttribution"
        }
      ]
    },
    "AuthorizationNotRequested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "not_requested"
        }
      },
      "required": [
        "state"
      ]
    },
    "AuthorizationRequested": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "requested_unknown",
            "denied"
          ]
        },
        "request_ref": {
          "$ref": "#/$defs/Opaque"
        }
      },
      "required": [
        "state",
        "request_ref"
      ]
    },
    "AuthorizationGranted": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "granted"
        },
        "request_ref": {
          "$ref": "#/$defs/Opaque"
        },
        "admission_ref": {
          "$ref": "#/$defs/Opaque"
        }
      },
      "required": [
        "state",
        "request_ref",
        "admission_ref"
      ]
    },
    "AuthorizationObservation": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthorizationNotRequested"
        },
        {
          "$ref": "#/$defs/AuthorizationRequested"
        },
        {
          "$ref": "#/$defs/AuthorizationGranted"
        }
      ]
    },
    "ExecutionObservation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "not_dispatched",
            "completed",
            "failed",
            "cancelled",
            "unknown"
          ]
        },
        "seal": {
          "type": "boolean"
        },
        "prepared_at": {
          "$ref": "#/$defs/UtcInstant"
        },
        "dispatch_started_at": {
          "anyOf": [
            {
              "$ref": "#/$defs/UtcInstant"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "outcome",
        "seal",
        "prepared_at",
        "dispatch_started_at"
      ]
    },
    "ReportedCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "reported"
        },
        "count": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "state",
        "count"
      ]
    },
    "UnreportedCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "unreported"
        }
      },
      "required": [
        "state"
      ]
    },
    "InapplicableCount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "not_applicable"
        }
      },
      "required": [
        "state"
      ]
    },
    "CountObservation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReportedCount"
        },
        {
          "$ref": "#/$defs/UnreportedCount"
        },
        {
          "$ref": "#/$defs/InapplicableCount"
        }
      ]
    },
    "SupportedProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "supported"
        }
      },
      "required": [
        "state"
      ]
    },
    "UnsupportedProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "unsupported"
        },
        "reason": {
          "type": "string",
          "enum": [
            "unsupported_usage_category",
            "unsupported_service_tier",
            "unverified_source_semantics"
          ]
        }
      },
      "required": [
        "state",
        "reason"
      ]
    },
    "ProfileAssessment": {
      "anyOf": [
        {
          "$ref": "#/$defs/SupportedProfile"
        },
        {
          "$ref": "#/$defs/UnsupportedProfile"
        }
      ]
    },
    "TokenUsageV1": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile_id": {
          "type": "string",
          "const": "token_usage_v1"
        },
        "unit": {
          "type": "string",
          "const": "token"
        },
        "source_protocol": {
          "type": "string",
          "enum": [
            "openai_chat_completions",
            "ollama_openai_chat_completions"
          ]
        },
        "aggregation_mode": {
          "type": "string",
          "const": "final_cumulative"
        },
        "input_total": {
          "$ref": "#/$defs/CountObservation"
        },
        "output_total": {
          "$ref": "#/$defs/CountObservation"
        },
        "total": {
          "$ref": "#/$defs/CountObservation"
        },
        "input_cache_read": {
          "$ref": "#/$defs/CountObservation"
        },
        "input_cache_write": {
          "$ref": "#/$defs/CountObservation"
        },
        "output_reasoning": {
          "$ref": "#/$defs/CountObservation"
        },
        "totals_state": {
          "type": "string",
          "enum": [
            "known_zero",
            "known_nonzero",
            "unknown"
          ]
        },
        "classification_state": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "profile_assessment": {
          "$ref": "#/$defs/ProfileAssessment"
        }
      },
      "required": [
        "profile_id",
        "unit",
        "source_protocol",
        "aggregation_mode",
        "input_total",
        "output_total",
        "total",
        "input_cache_read",
        "input_cache_write",
        "output_reasoning",
        "totals_state",
        "classification_state",
        "profile_assessment"
      ]
    },
    "NormalizedUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "normalized"
        },
        "value": {
          "$ref": "#/$defs/TokenUsageV1"
        },
        "raw_usage_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "value",
        "raw_usage_digest"
      ]
    },
    "UnresolvedUsage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "type": "string",
          "const": "unresolved"
        },
        "reason": {
          "type": "string",
          "enum": [
            "missing_usage",
            "invalid_usage",
            "incomplete_response",
            "unsupported_source"
          ]
        },
        "raw_usage_digest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "state",
        "reason",
        "raw_usage_digest"
      ]
    },
    "UsageObservation": {
      "anyOf": [
        {
          "$ref": "#/$defs/NormalizedUsage"
        },
        {
          "$ref": "#/$defs/UnresolvedUsage"
        }
      ]
    },
    "Predecessor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "event_id": {
          "$ref": "#/$defs/Uuid"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "event_id",
        "digest"
      ]
    },
    "ModelUsageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_version": {
          "type": "string",
          "const": "1.0.0"
        },
        "identity": {
          "$ref": "#/$defs/EvidenceIdentity"
        },
        "planned": {
          "$ref": "#/$defs/PlannedBinding"
        },
        "actual": {
          "$ref": "#/$defs/ActualAttribution"
        },
        "authorization_observation": {
          "$ref": "#/$defs/AuthorizationObservation"
        },
        "execution": {
          "$ref": "#/$defs/ExecutionObservation"
        },
        "usage": {
          "$ref": "#/$defs/UsageObservation"
        },
        "revision": {
          "$ref": "#/$defs/Ordinal"
        },
        "predecessor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Predecessor"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "$ref": "#/$defs/UtcInstant"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "artifact_version",
        "identity",
        "planned",
        "actual",
        "authorization_observation",
        "execution",
        "usage",
        "revision",
        "predecessor",
        "observed_at",
        "digest"
      ]
    }
  },
  "$ref": "#/$defs/ModelUsageEvidence"
}
