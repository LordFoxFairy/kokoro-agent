{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.kokoro.invalid/presentation/stream-v1.schema.json",
  "title": "Kokoro Presentation authorized stream response v1",
  "description": "One frozen authorized replay page or non-durable draining SSE event. Cursors belong to this read-time envelope; each authorized item carries the exact persisted RFC 8785/JCS UTF-8 bytes of one immutable full AG-UI frame.",
  "oneOf": [
    {
      "$ref": "#/$defs/replayPage"
    },
    {
      "$ref": "#/$defs/drainingEvent"
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "cursor": {
      "type": "string",
      "minLength": 16,
      "maxLength": 2048,
      "pattern": "^(?=.*[A-Za-z._~-])[A-Za-z0-9._~-]+$"
    },
    "uint64": {
      "oneOf": [
        {
          "const": "0"
        },
        {
          "$ref": "https://contracts.kokoro.invalid/presentation/domain-event-v1.schema.json#/$defs/positiveUint64"
        }
      ]
    },
    "authorizedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cursor",
        "durableSeq",
        "eventName",
        "dataUtf8"
      ],
      "properties": {
        "cursor": {
          "$ref": "#/$defs/cursor"
        },
        "durableSeq": {
          "$ref": "https://contracts.kokoro.invalid/presentation/domain-event-v1.schema.json#/$defs/positiveUint64"
        },
        "eventName": {
          "$ref": "https://contracts.kokoro.invalid/presentation/ag-ui-frame-v1.schema.json#/$defs/eventType"
        },
        "dataUtf8": {
          "type": "string",
          "minLength": 2
        }
      }
    },
    "replayPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractRevision",
        "cursorRevision",
        "siteId",
        "sessionId",
        "streamEpoch",
        "snapshotCursor",
        "afterDurableSeq",
        "throughDurableSeq",
        "frames",
        "hasMore",
        "nextAfterDurableSeq"
      ],
      "properties": {
        "contractRevision": {
          "const": "kokoro.presentation.stream.v1"
        },
        "cursorRevision": {
          "const": "opaque-session-cursor-v1"
        },
        "siteId": {
          "$ref": "#/$defs/id"
        },
        "sessionId": {
          "$ref": "#/$defs/id"
        },
        "streamEpoch": {
          "$ref": "https://contracts.kokoro.invalid/presentation/domain-event-v1.schema.json#/$defs/positiveUint64"
        },
        "snapshotCursor": {
          "$ref": "#/$defs/cursor"
        },
        "afterDurableSeq": {
          "$ref": "#/$defs/uint64"
        },
        "throughDurableSeq": {
          "$ref": "#/$defs/uint64"
        },
        "frames": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "$ref": "#/$defs/authorizedFrame"
          }
        },
        "hasMore": {
          "type": "boolean"
        },
        "nextAfterDurableSeq": {
          "$ref": "#/$defs/uint64"
        }
      }
    },
    "drainingEvent": {
      "type": "object",
      "description": "One non-durable outer SSE event. The serializer emits eventName and data but no id field.",
      "additionalProperties": false,
      "required": [
        "eventName",
        "data"
      ],
      "properties": {
        "eventName": {
          "const": "kokoro.presentation.draining.v1"
        },
        "data": {
          "$ref": "#/$defs/drainingData"
        }
      }
    },
    "drainingData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractRevision",
        "cursorRevision",
        "siteId",
        "sessionId",
        "streamEpoch",
        "action"
      ],
      "properties": {
        "contractRevision": {
          "const": "kokoro.presentation.stream-draining.v1"
        },
        "cursorRevision": {
          "const": "opaque-session-cursor-v1"
        },
        "siteId": {
          "$ref": "#/$defs/id"
        },
        "sessionId": {
          "$ref": "#/$defs/id"
        },
        "streamEpoch": {
          "$ref": "https://contracts.kokoro.invalid/presentation/domain-event-v1.schema.json#/$defs/positiveUint64"
        },
        "lastDurableCursor": {
          "$ref": "#/$defs/cursor",
          "description": "Exact Last-Event-ID from this attach request, returned for retry without advancement; omitted when the first attach had no cursor."
        },
        "action": {
          "const": "retry-same-cursor"
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        }
      }
    }
  }
}
